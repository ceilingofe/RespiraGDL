# Copiar a bot/.env y llenar. NUNCA subir bot/.env al repo.
# Token que da @BotFather en Telegram (también se acepta TELEGRAM_BOT_TOKEN, como en el .env.example de la raíz)
TELEGRAM_TOKEN=
# URL de la API de Juan (backend/README.md). Si no responde, el bot usa datos de ejemplo y lo dice.
API_URL=http://localhost:8000
# Hora diaria del aviso automático a las familias (HH:MM, hora de Guadalajara). Se cambia con /hora en Telegram.
HORA_AVISO=07:00
# Escuela de este bot (id de la API) y nombre que sale en los avisos
ESCUELA_ID=miravalle
ESCUELA_NOMBRE=Esc. Prim. Miravalle T/M
# Zona que sale en el aviso: "PM2.5 esperado en Miravalle"
ZONA=Miravalle
# (Opcional) Archivo donde el bot guarda las familias (solo chat y grupos). Por defecto bot/datos/familias.json
# DATOS_PATH=datos/familias.json
# Cada cuántos segundos revisa los avisos que mandan el director o la maestra desde el tablero
INTERVALO_AVISOS=30
