# Copiar a bot/.env y llenar. NUNCA subir bot/.env al repo.
# Token que da @BotFather en Telegram (también se acepta TELEGRAM_BOT_TOKEN, como en el .env.example de la raíz)
TELEGRAM_TOKEN=
# URL de la API de backend (cuando exista)
API_URL=http://localhost:8000
# Hora diaria del aviso automático a las familias (HH:MM, hora de Guadalajara). Se cambia con /hora en Telegram.
HORA_AVISO=07:00
